# Binance hosts. Copy to .env.local to override. Both are optional; these
# are the defaults. The market-data-only hosts avoid the HTTP 451 geo-block
# that api.binance.com / stream.binance.com return in some regions.
NEXT_PUBLIC_BINANCE_REST_URL=https://data-api.binance.vision/api/v3
NEXT_PUBLIC_BINANCE_WS_URL=wss://data-stream.binance.vision
